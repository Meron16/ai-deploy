{
  "name": "ai-deploy",
  "displayName": "AI Deploy",
  "description": "AI-powered deployment copilot for VS Code — deploy backend, frontend, and fullstack apps with self-healing.",
  "version": "0.4.1",
  "publisher": "ai-deploy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ai-deploy.deployProject",
    "onCommand:ai-deploy.testLocal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-deploy.deployProject",
        "title": "AI Deploy Project"
      },
      {
        "command": "ai-deploy.testLocal",
        "title": "AI Deploy: Test Locally (Docker)"
      }
    ],
    "configuration": {
      "title": "AI Deploy",
      "properties": {
        "aiDeploy.maxRetries": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum deploy attempts with auto-fix between each retry."
        },
        "aiDeploy.useAiAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Use AI to analyze deployment failures (requires API key for LLM; falls back to heuristics)."
        },
        "aiDeploy.openAiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible API key for LLM error analysis."
        },
        "aiDeploy.openAiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL."
        },
        "aiDeploy.openAiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model used for deployment failure analysis."
        },
        "aiDeploy.runLocalBuildFirst": {
          "type": "boolean",
          "default": true,
          "description": "Run npm run build locally before deploying to catch errors early."
        },
        "aiDeploy.autoRetryAfterFix": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run recovery fixes in the terminal and retry deploy without asking."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint src --ext ts",
    "prepublish": "npm run build",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.3"
  }
}
